# OpenRouter is primary and is restricted in code to reviewed :free models.
OPENROUTER_API_KEY=
# Ordered failover pool. Values must be reviewed :free model IDs; unknown IDs
# fail closed. A rate-limited model is skipped until Retry-After (or 5 minutes).
OPENROUTER_FREE_MODELS=z-ai/glm-5.2:free,minimax/minimax-m3:free,minimax/minimax-m2.7:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free

# Gemini is the direct full-context generation/review fallback after OpenRouter.
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq is the independent small-context quality-review fallback. The configured
# account limit is too small for complete-portfolio generation.
GROQ_API_KEY=

# Generate separate secrets with: openssl rand -hex 32
CHAT_RATE_LIMIT_SECRET=
INQUIRY_RATE_LIMIT_SECRET=

RESEND_API_KEY=
FROM_EMAIL="Portfolio <portfolio@example.com>"
EMAIL_TO=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Optional; these defaults keep role and project inquiries separate
GOOGLE_ROLE_INQUIRIES_RANGE="'Role Inquiries'!A:J"
GOOGLE_PROJECT_INQUIRIES_RANGE="'Project Inquiries'!A:J"

# Neon Postgres; required for comments, analytics, inquiries, chat telemetry, limits, and migrations
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon Auth; enable Google in Neon Console and add the application origins
NEON_AUTH_BASE_URL=https://your-neon-auth-url.neon.tech
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Only this Google account can access the owner dashboard
OWNER_EMAIL=montasimmamun@gmail.com
