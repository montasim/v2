{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "pnpm chat:verify-exact",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "chat:evaluate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/evaluate-portfolio-chat.ts",
    "chat:compile-exact": "node --import tsx src/scripts/compile-chat-exact-answers.ts",
    "chat:verify-exact": "node --import tsx src/scripts/verify-chat-exact-answers.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"*.{ts,js,json,md}\"",
    "check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.45",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/react": "^4.0.71",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "@toon-format/toon": "4.1.1",
    "ai": "^7.0.68",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "obscenity": "^0.4.6",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.12",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
